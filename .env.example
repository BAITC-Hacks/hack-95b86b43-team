# Proposed settings only. No application reads this file yet.
APP_ENV=development
# Define locally when PostgreSQL is configured. Never commit credentials.
DATABASE_URL=
# Resolve paths from the repository root, not from the process working directory.
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
CACHE_DIR=data/cache
# Future frontend development origin and API base URL.
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
