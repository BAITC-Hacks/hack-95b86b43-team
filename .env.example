# Copy to .env in the repository root. Never commit real credentials.
APP_ENV=development
POSTGRES_DB=elektrokomplekt
POSTGRES_USER=elektrokomplekt
# Set a local password, then use the same URL-encoded password in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://elektrokomplekt:YOUR_PASSWORD@127.0.0.1:5433/elektrokomplekt
# Resolve paths from the repository root, not from the process working directory.
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
CACHE_DIR=data/cache
# Future frontend development origin and API base URL.
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
